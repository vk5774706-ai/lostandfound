# Express Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_lost_and_found_2026_change_in_production
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL Configuration
# Get these from your Supabase Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
# Using the service_role key is recommended for backend server to bypass RLS, or anon key
SUPABASE_KEY=your-supabase-service-role-or-anon-key
